# The defautl admin account password
KLAPZ_ADMIN_PASSWORD=adminadmin

# The database connection string
KLAPZ_DATABASE_URL=sqlite://C:/Users/xxxx/Documents/dev/klapz/klapz-server/klapz.db?mode=rwc

# The path to the Klapz ffmpeg binary, needed for transcoding and analyzing media files.
KLAPZ_TRANSCODER=C:\Users\xxx\Documents\dev\klapz\klapz-ffmpeg\ffmpeg.exe

# Secret used to sign tokens and sessions
KLAPZ_SESSION_SECRET=awesome-secret

# Extra origins of the web client allowed by CORS, separated by commas
# (https://app.klapz.io always is, and localhost / 127.0.0.1 in a debug build)
#KLAPZ_CORS_ORIGINS=https://klapz.example,http://192.168.1.2:5173
